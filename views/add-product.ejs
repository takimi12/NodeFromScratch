<%- include('includes/header', { activePage: activePage }) %>

<h1>Add product</h1>

<form method="POST" action="/api/v1/product">
  <label>ID</label>
  <input type="text" name="id" />

  <label>Name</label>
  <input type="text" name="name" />

  <label>Price</label>
  <input type="text" name="price" />

  <button type="submit">Add</button>
</form>
